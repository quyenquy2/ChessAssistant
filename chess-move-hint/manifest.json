{
  "manifest_version": 3,
  "name": "Chess Move Hint",
  "version": "1.0.0",
  "description": "Giữ phím tắt để hiện nước đi tối ưu tại góc màn hình trên chess.com.",
  "permissions": ["storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_popup": "options.html",
    "default_title": "Chess Move Hint - cài phím tắt"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.chess.com/*"],
      "js": ["lib/chess.min.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.chess.com/*"],
      "js": ["fen-bridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["engine/stockfish.js"],
      "matches": ["https://*.chess.com/*"]
    }
  ]
}